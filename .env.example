# =============================================================================
# AntriSehat — contoh environment (PRD 2.5)
# Salin ke .env lalu isi nilai rahasia. JANGAN commit file .env.
#   cp .env.example .env
#   php artisan key:generate            (lokal)
#   docker run --rm <image> php artisan key:generate --show   (lalu tempel ke APP_KEY)
# =============================================================================

APP_NAME=AntriSehat
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# stderr agar log terbaca lewat `docker compose logs app|scheduler`
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# DB_HOST=db adalah nama service di compose.yaml
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=antrisehat
DB_USERNAME=antrisehat
DB_PASSWORD=change-this-password
DB_ROOT_PASSWORD=change-this-root-password

# file (bukan database) agar /health tetap bisa merespons 503 saat DB mati
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Aturan bisnis & scheduler
ANTRISEHAT_MAKS_PASIEN=30
ANTRISEHAT_DURASI_SLOT=15
# Default tengah malam. Untuk demo scheduler gunakan "* * * * *"
ANTRISEHAT_RESET_CRON="0 0 * * *"

# Dipakai compose.yaml untuk nama image: ${DOCKERHUB_USER}/antrisehat-app:${IMAGE_TAG}
DOCKERHUB_USER=your-dockerhub-username
IMAGE_TAG=latest
